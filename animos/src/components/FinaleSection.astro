---
// Final section - grand finale message
---

<section class="finale-section" id="finaleSection">
  <div class="finale-stars" id="finaleStars"></div>
  
  <div class="finale-content">
    <div class="finale-hamster-scene reveal-scale">
      <svg viewBox="0 0 300 250" width="280" height="230" class="finale-svg">
        <!-- Moon -->
        <circle cx="150" cy="60" r="40" fill="#ffd700" opacity="0.15"/>
        <circle cx="150" cy="60" r="35" fill="#ffd700" opacity="0.1"/>
        
        <!-- Stars around -->
        <text x="40" y="40" font-size="12" opacity="0.6">✦</text>
        <text x="250" y="50" font-size="10" opacity="0.5">✦</text>
        <text x="80" y="25" font-size="8" opacity="0.4">✦</text>
        <text x="220" y="30" font-size="14" opacity="0.5">✦</text>
        <text x="30" y="80" font-size="10" opacity="0.3">✦</text>
        <text x="270" y="80" font-size="8" opacity="0.4">✦</text>
        
        <!-- Ground / Hill -->
        <ellipse cx="150" cy="210" rx="130" ry="30" fill="#1a1520" stroke="#2a1f30" stroke-width="1"/>
        
        <!-- Left: Cat (him) sitting -->
        <g transform="translate(100, 145)">
          <ellipse cx="0" cy="25" rx="20" ry="16" fill="#3a3a3a"/>
          <circle cx="0" cy="0" r="17" fill="#3a3a3a"/>
          <!-- Ears -->
          <polygon points="-14,-12 -10,-26 -4,-12" fill="#3a3a3a"/>
          <polygon points="-12,-14 -10,-23 -6,-14" fill="#ffb6c1"/>
          <polygon points="4,-12 10,-26 14,-12" fill="#3a3a3a"/>
          <polygon points="6,-14 10,-23 12,-14" fill="#ffb6c1"/>
          <!-- Eyes (looking at hamster) -->
          <circle cx="-5" cy="-2" r="3" fill="#7dcea0"/>
          <circle cx="-4" cy="-3" r="1.2" fill="#1a1a1a"/>
          <circle cx="5" cy="-2" r="3" fill="#7dcea0"/>
          <circle cx="6" cy="-3" r="1.2" fill="#1a1a1a"/>
          <ellipse cx="0" cy="4" rx="2" ry="1.2" fill="#ffb6c1"/>
          <path d="M -5 6 Q -2 5 0 6 Q 2 5 5 6" fill="none" stroke="#888" stroke-width="0.8"/>
          <!-- Tail wrapping -->
          <path d="M 15 30 Q 30 20 25 35 Q 20 45 10 40" fill="none" stroke="#3a3a3a" stroke-width="4" stroke-linecap="round"/>
        </g>
        
        <!-- Right: Hamster (her) leaning on cat -->
        <g transform="translate(165, 142)">
          <ellipse cx="0" cy="25" rx="20" ry="16" fill="#f4d4a0"/>
          <ellipse cx="0" cy="30" rx="13" ry="11" fill="#fef0d6"/>
          <circle cx="0" cy="0" r="17" fill="#f4d4a0"/>
          <ellipse cx="-13" cy="-13" rx="6" ry="8" fill="#f4d4a0"/>
          <ellipse cx="-13" cy="-13" rx="3.5" ry="5.5" fill="#ffb6c1"/>
          <ellipse cx="13" cy="-13" rx="6" ry="8" fill="#f4d4a0"/>
          <ellipse cx="13" cy="-13" rx="3.5" ry="5.5" fill="#ffb6c1"/>
          <!-- Closed happy eyes -->
          <path d="M -8 -2 Q -5 -6 -2 -2" fill="none" stroke="#2c2c2c" stroke-width="2" stroke-linecap="round"/>
          <path d="M 2 -2 Q 5 -6 8 -2" fill="none" stroke="#2c2c2c" stroke-width="2" stroke-linecap="round"/>
          <ellipse cx="0" cy="4" rx="2" ry="1.5" fill="#ffb6c1"/>
          <path d="M -4 7 Q 0 11 4 7" fill="none" stroke="#e8a080" stroke-width="1.2" stroke-linecap="round"/>
          <ellipse cx="-11" cy="2" rx="5" ry="3" fill="#ffb6c1" opacity="0.4"/>
          <ellipse cx="11" cy="2" rx="5" ry="3" fill="#ffb6c1" opacity="0.4"/>
          <!-- Small bow -->
          <text x="-4" y="-22" font-size="10">🎀</text>
        </g>
        
        <!-- Heart above them -->
        <g class="finale-heart-float">
          <text x="118" y="120" font-size="28">💕</text>
        </g>
        
        <!-- Tiny flowers on ground -->
        <text x="60" y="215" font-size="10">🌸</text>
        <text x="200" y="218" font-size="8">🌸</text>
        <text x="120" y="220" font-size="6">🌸</text>
        <text x="240" y="215" font-size="7">✿</text>
      </svg>
    </div>

    <h2 class="finale-title reveal">
      <span class="finale-word" style="--i: 0">Para</span>
      <span class="finale-word" style="--i: 1">ti,</span>
      <span class="finale-word" style="--i: 2">siempre,</span>
      <br>
      <span class="finale-name" style="--i: 3">Mi Yuli</span>
    </h2>

    <div class="finale-poem reveal">
      <p class="finale-poem-line">No te traigo rosas ni promesas vacías,</p>
      <p class="finale-poem-line">te traigo un pedacito de mi alma hecho código,</p>
      <p class="finale-poem-line">cruzando la distancia solo para ti, corazón.</p>
      <br>
      <p class="finale-poem-line">Soy ese loquito rarito y tontito</p>
      <p class="finale-poem-line">que no sabe amar de otra forma</p>
      <p class="finale-poem-line">que no sea con todo el corazoncito.</p>
      <br>
      <p class="finale-poem-line">Y si estás dispuesta a intentar,</p>
      <p class="finale-poem-line">creo que ambos podríamos amar bien bonito. 💕</p>
    </div>

    <div class="finale-signature reveal">
      <p>Con todo lo que soy,</p>
      <p class="finale-sign-name">Tu Josii 💕</p>
    </div>

    <div class="finale-date reveal">
      San Valentín 2026 🌹
    </div>

    <!-- Replay button -->
    <button class="kawaii-btn finale-btn reveal" id="replayBtn">
      🌸 Volver al inicio 💕
    </button>
  </div>
</section>

<script>
  // Generate stars for finale background
  const finaleStars = document.getElementById('finaleStars');
  if (finaleStars) {
    for (let i = 0; i < 80; i++) {
      const star = document.createElement('span');
      star.className = 'finale-star';
      star.textContent = Math.random() > 0.5 ? '✦' : '·';
      star.style.left = Math.random() * 100 + '%';
      star.style.top = Math.random() * 100 + '%';
      star.style.animationDelay = Math.random() * 4 + 's';
      star.style.animationDuration = (2 + Math.random() * 3) + 's';
      star.style.fontSize = (6 + Math.random() * 10) + 'px';
      finaleStars.appendChild(star);
    }
  }

  // Replay button
  document.getElementById('replayBtn')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // Close celebration overlay
  document.getElementById('allRevealed')?.addEventListener('click', function() {
    this.classList.remove('show');
  });
</script>

<style>
  .finale-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    background: radial-gradient(ellipse at center, #15081a 0%, #0a0a0a 70%);
    position: relative;
    overflow: hidden;
  }

  .finale-stars {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .finale-star {
    position: absolute;
    color: var(--pink-light);
    animation: twinkle ease-in-out infinite;
    opacity: 0;
  }

  @keyframes twinkle {
    0%, 100% { opacity: 0; transform: scale(0.5); }
    50% { opacity: 0.7; transform: scale(1.2); }
  }

  .finale-content {
    text-align: center;
    z-index: 2;
    max-width: 600px;
  }

  .finale-hamster-scene {
    margin-bottom: 30px;
  }

  .finale-svg {
    filter: drop-shadow(0 0 30px rgba(255, 105, 180, 0.2));
  }

  .finale-heart-float {
    animation: finaleHeartFloat 3s ease-in-out infinite;
  }

  @keyframes finaleHeartFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .finale-title {
    font-family: var(--font-handwrite);
    font-size: 2rem;
    color: var(--text-primary);
    margin-bottom: 30px;
    line-height: 1.5;
  }

  .finale-word {
    display: inline-block;
    animation: wordAppear 0.5s ease-out forwards;
    animation-delay: calc(var(--i) * 0.2s);
    opacity: 0;
    transform: translateY(20px);
  }

  .finale-name {
    font-family: var(--font-display);
    font-size: 4rem;
    color: var(--pink);
    display: inline-block;
    animation: wordAppear 0.5s ease-out forwards, glowPulse 3s ease-in-out infinite;
    animation-delay: calc(var(--i) * 0.2s), calc(var(--i) * 0.2s + 0.5s);
    opacity: 0;
    transform: translateY(20px);
    text-shadow: 0 0 20px var(--pink), 0 0 40px var(--pink-dark);
  }

  @keyframes wordAppear {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes glowPulse {
    0%, 100% { text-shadow: 0 0 10px var(--pink), 0 0 20px var(--pink-dark); }
    50% { text-shadow: 0 0 20px var(--pink), 0 0 40px var(--pink), 0 0 60px var(--pink-dark); }
  }

  .finale-poem {
    margin-bottom: 30px;
  }

  .finale-poem-line {
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 2;
    font-weight: 300;
  }

  .finale-signature {
    margin-bottom: 15px;
  }

  .finale-signature p {
    font-family: var(--font-handwrite);
    font-size: 1.2rem;
    color: var(--pink-light);
  }

  .finale-sign-name {
    font-family: var(--font-display);
    font-size: 2rem;
    color: var(--pink);
    margin-top: 5px;
  }

  .finale-date {
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 30px;
    letter-spacing: 2px;
  }

  .finale-btn {
    margin-top: 10px;
  }

  @media (max-width: 768px) {
    .finale-title {
      font-size: 1.5rem;
    }
    .finale-name {
      font-size: 3rem;
    }
    .finale-poem-line {
      font-size: 0.85rem;
    }
    .finale-svg {
      width: 220px;
      height: 180px;
    }
  }
</style>
