---
interface Props {
  title?: string;
}

const { title = "Para ti, Yuli 💕" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content="Un regalo de San Valentín especial para Yuli 💕🐹" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Quicksand:wght@300;400;500;600;700&family=Sacramento&display=swap" rel="stylesheet" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='0.9em' font-size='90'>🐹</text></svg>" />
  </head>
  <body>
    <!-- Cursor trail canvas -->
    <canvas id="cursorCanvas"></canvas>
    
    <!-- Floating background particles -->
    <div class="floating-hearts" id="floatingHearts"></div>

    <slot />

    <!-- Scroll indicator -->
    <div class="scroll-indicator" id="scrollIndicator">
      <span>↓</span>
      <p>Desliza para descubrir más</p>
    </div>

    <script>
      // Floating hearts background
      function createFloatingHearts() {
        const container = document.getElementById('floatingHearts');
        if (!container) return;
        const emojis = ['💕', '💖', '💗', '🐹', '✨', '💝', '🌸', '💕', '⭐', '🐹'];
        
        for (let i = 0; i < 30; i++) {
          const heart = document.createElement('span');
          heart.className = 'bg-heart';
          heart.textContent = emojis[Math.floor(Math.random() * emojis.length)];
          heart.style.left = Math.random() * 100 + '%';
          heart.style.animationDuration = (8 + Math.random() * 12) + 's';
          heart.style.animationDelay = Math.random() * 10 + 's';
          heart.style.fontSize = (12 + Math.random() * 24) + 'px';
          heart.style.opacity = String(0.1 + Math.random() * 0.3);
          container.appendChild(heart);
        }
      }
      createFloatingHearts();

      // Cursor heart trail
      const canvas = document.getElementById('cursorCanvas') as HTMLCanvasElement;
      if (canvas) {
        const ctx = canvas.getContext('2d');
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
        
        const particles: {x: number, y: number, vx: number, vy: number, life: number, maxLife: number, size: number, emoji: string}[] = [];
        const heartEmojis = ['💖', '💗', '💕', '🐹', '✨'];
        
        window.addEventListener('resize', () => {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        });
        
        document.addEventListener('mousemove', (e) => {
          if (Math.random() > 0.7) {
            particles.push({
              x: e.clientX,
              y: e.clientY,
              vx: (Math.random() - 0.5) * 2,
              vy: -Math.random() * 2 - 1,
              life: 0,
              maxLife: 40 + Math.random() * 20,
              size: 10 + Math.random() * 10,
              emoji: heartEmojis[Math.floor(Math.random() * heartEmojis.length)]
            });
          }
        });
        
        function animateParticles() {
          if (!ctx) return;
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          
          for (let i = particles.length - 1; i >= 0; i--) {
            const p = particles[i];
            p.x += p.vx;
            p.y += p.vy;
            p.life++;
            
            const alpha = 1 - p.life / p.maxLife;
            ctx.globalAlpha = alpha;
            ctx.font = p.size + 'px serif';
            ctx.fillText(p.emoji, p.x, p.y);
            
            if (p.life >= p.maxLife) {
              particles.splice(i, 1);
            }
          }
          
          requestAnimationFrame(animateParticles);
        }
        animateParticles();
      }

      // Scroll indicator hide on scroll
      window.addEventListener('scroll', () => {
        const indicator = document.getElementById('scrollIndicator');
        if (indicator && window.scrollY > 100) {
          indicator.style.opacity = '0';
          indicator.style.pointerEvents = 'none';
        } else if (indicator) {
          indicator.style.opacity = '1';
          indicator.style.pointerEvents = 'auto';
        }
      });

      // Click sparkle effect anywhere
      document.addEventListener('click', (e) => {
        for (let i = 0; i < 8; i++) {
          const sparkle = document.createElement('span');
          sparkle.className = 'click-sparkle';
          sparkle.textContent = ['✨', '💖', '🐹', '💕', '⭐'][Math.floor(Math.random() * 5)];
          sparkle.style.left = e.pageX + 'px';
          sparkle.style.top = e.pageY + 'px';
          const angle = (Math.PI * 2 * i) / 8;
          sparkle.style.setProperty('--dx', Math.cos(angle) * 60 + 'px');
          sparkle.style.setProperty('--dy', Math.sin(angle) * 60 + 'px');
          document.body.appendChild(sparkle);
          setTimeout(() => sparkle.remove(), 800);
        }
      });

      // Reveal on scroll (global observer)
      const globalObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('visible');
          }
        });
      }, { threshold: 0.1 });

      document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach(el => {
        globalObserver.observe(el);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg-primary: #0a0a0a;
    --bg-secondary: #111111;
    --bg-card: #1a1a1a;
    --bg-card-hover: #222222;
    --pink-light: #ff9ec6;
    --pink: #ff69b4;
    --pink-dark: #e91e8a;
    --rose: #ff4d6d;
    --lavender: #c3a6ff;
    --gold: #ffd700;
    --text-primary: #ffffff;
    --text-secondary: #cccccc;
    --text-muted: #888888;
    --font-display: 'Sacramento', cursive;
    --font-handwrite: 'Dancing Script', cursive;
    --font-body: 'Quicksand', sans-serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scrollbar-width: thin;
    scrollbar-color: var(--pink) var(--bg-primary);
  }

  html::-webkit-scrollbar { width: 8px; }
  html::-webkit-scrollbar-track { background: var(--bg-primary); }
  html::-webkit-scrollbar-thumb { background: var(--pink); border-radius: 4px; }

  body {
    font-family: var(--font-body);
    background: var(--bg-primary);
    color: var(--text-primary);
    overflow-x: hidden;
  }

  #cursorCanvas {
    position: fixed;
    top: 0; left: 0;
    width: 100vw; height: 100vh;
    pointer-events: none;
    z-index: 9999;
  }

  .floating-hearts {
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .bg-heart {
    position: absolute;
    bottom: -50px;
    animation: floatUp linear infinite;
  }

  @keyframes floatUp {
    0% { transform: translateY(0) rotate(0deg) scale(1); opacity: 0; }
    10% { opacity: 0.3; }
    90% { opacity: 0.1; }
    100% { transform: translateY(-110vh) rotate(720deg) scale(0.5); opacity: 0; }
  }

  .scroll-indicator {
    position: fixed;
    bottom: 30px; left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    text-align: center;
    color: var(--pink-light);
    transition: opacity 0.5s;
    animation: bounceDown 2s ease-in-out infinite;
  }

  .scroll-indicator span { font-size: 2rem; display: block; }
  .scroll-indicator p { font-size: 0.8rem; margin-top: 4px; letter-spacing: 1px; }

  @keyframes bounceDown {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(10px); }
  }

  .click-sparkle {
    position: absolute;
    pointer-events: none;
    font-size: 20px;
    animation: sparkleOut 0.8s ease-out forwards;
    z-index: 10000;
  }

  @keyframes sparkleOut {
    0% { transform: translate(0, 0) scale(1); opacity: 1; }
    100% { transform: translate(var(--dx), var(--dy)) scale(0); opacity: 0; }
  }

  section { position: relative; z-index: 1; }

  /* Reveal animations */
  .reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s cubic-bezier(0.4,0,0.2,1); }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal-left { opacity: 0; transform: translateX(-50px); transition: all 0.8s cubic-bezier(0.4,0,0.2,1); }
  .reveal-left.visible { opacity: 1; transform: translateX(0); }
  .reveal-right { opacity: 0; transform: translateX(50px); transition: all 0.8s cubic-bezier(0.4,0,0.2,1); }
  .reveal-right.visible { opacity: 1; transform: translateX(0); }
  .reveal-scale { opacity: 0; transform: scale(0.8); transition: all 0.8s cubic-bezier(0.4,0,0.2,1); }
  .reveal-scale.visible { opacity: 1; transform: scale(1); }

  .glow { text-shadow: 0 0 10px var(--pink), 0 0 20px var(--pink), 0 0 40px var(--pink-dark); }

  /* Section titles reusable */
  .section-title {
    font-family: var(--font-display);
    font-size: 3.5rem;
    color: var(--pink);
    margin-bottom: 10px;
    text-shadow: 0 0 20px rgba(255, 105, 180, 0.3);
  }
  .title-deco { display: inline-block; animation: decoSpin 3s linear infinite; }
  @keyframes decoSpin {
    0% { transform: rotate(0deg) scale(1); }
    50% { transform: rotate(180deg) scale(1.2); }
    100% { transform: rotate(360deg) scale(1); }
  }
  .section-subtitle {
    font-family: var(--font-handwrite);
    font-size: 1.2rem;
    color: var(--text-muted);
  }

  .kawaii-btn {
    background: linear-gradient(135deg, var(--pink), var(--pink-dark));
    color: white;
    border: none;
    padding: 12px 32px;
    border-radius: 50px;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s;
    box-shadow: 0 4px 15px rgba(255, 105, 180, 0.4);
  }
  .kawaii-btn:hover {
    transform: translateY(-2px) scale(1.05);
    box-shadow: 0 6px 25px rgba(255, 105, 180, 0.6);
  }
  .kawaii-btn:active { transform: translateY(0) scale(0.98); }

  @media (max-width: 768px) {
    .scroll-indicator p { font-size: 0.7rem; }
    .section-title { font-size: 2.5rem; }
  }
</style>
